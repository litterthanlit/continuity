{
  "name": "@litterthanlit/continuity",
  "version": "0.1.0",
  "description": "Motion design videos as code, for agents: a typed motion DSL, deterministic rendering, and eyes (lint, layout checks, contact sheets, motion analysis) so agents can see and prove what they make.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "litterthanlit",
  "homepage": "https://github.com/litterthanlit/continuity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litterthanlit/continuity.git"
  },
  "bugs": {
    "url": "https://github.com/litterthanlit/continuity/issues"
  },
  "keywords": [
    "motion-design",
    "video",
    "animation",
    "claude-code",
    "agents",
    "hyperframes",
    "kinetic-typography",
    "preact",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "ct": "bin/ct.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "bin",
    "src",
    "templates",
    "plugin/skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "ct": "node bin/ct.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/noto-sans-symbols": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@tailwindcss/node": "4.3.3",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "hyperframes": "0.8.140",
    "linkedom": "0.18.12",
    "preact": "11.0.0",
    "preact-render-to-string": "6.8.0",
    "puppeteer-core": "25.12.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@litterthanlit/continuity": "link:.",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@hyperframes/core": "0.8.140",
      "@hyperframes/engine": "0.8.140",
      "@hyperframes/producer": "0.8.140",
      "@hyperframes/lint": "0.8.140",
      "@hyperframes/parsers": "0.8.140",
      "@hyperframes/studio-server": "0.8.140"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
